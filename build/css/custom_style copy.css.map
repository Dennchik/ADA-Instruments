}

.artikul {
  font-size: 11px;
  padding: 10px 0;
}

.not_exist {
  filter: grayscale(100%);
  -webkit-filter: grayscale(100%);
  -moz-filter: grayscale(100%);
  -ms-filter: grayscale(100%);
  -o-filter: grayscale(100%);
  filter: url(desaturate.svg#greyscale);
  filter: gray;
  -webkit-filter: grayscale(1);
  opacity: 0.5;
}

.tab_accesories_list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: stretch;
  align-content: stretch;
  margin-left: -25px;
  margin-right: -25px;
}

.tab_accesories_list > li {
  width: 25%;
}

.tab_accesories_box .img_cont {
  display: block;
  background-size: auto 150px;
  background-repeat: no-repeat;
  background-position: center center;
  height: 190px;
}

.tab_accesories_box {
  display: block;
  margin-left: 25px;
  margin-right: 25px;
  position: relative;
}

/*================*/

.form_box_label {
  padding-left: 30px;
  position: relative;
  margin-bottom: 10px;
  font-size: 14px;
}

.form_box_label:after {
  content: ' ';
  position: absolute;
  width: 30px;
  height: 30px;
  top: 0;
  left: 0;
  font-family: IcoFont !important;
  speak: none;
  font-style: normal;
  font-weight: 400;
  font-variant: normal;
  text-transform: none;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  line-height: 1;
  font-feature-settings: 'liga';
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
  font-size: 20px;
  color: rgb(255, 51, 51);
}

.form_user_name:after {
  content: '\ecfd';
}

.form_user_tel:after {
  content: '\ec8a';
}

.form_user_mess:after {
  content: '\eb2a';
}

.modal-header {
  display: block;
  position: relative;
  border-bottom: 0px;
  padding-top: 60px;
  font-weight: 300;
}

.modal .close {
  position: absolute;
  top: 27px;
  right: 27px;
  float: none;
  font-size: 36px !important;
  width: 40px;
  height: 40px;
  line-height: 40px;
  padding: 0 !important;
  text-shadow: none !important;
}

.modal-footer {
  justify-content: center;
  padding: 0 10px 40px;
  border-top: 0px;
}

.font24 {
  font-size: 24px;
}

.modal .form-control {
  height: calc(1.5em + 0.75rem + 8px);
}

.modal-body {
  padding: 15px 50px;
}

.modal textarea.form-control {
  height: calc(4.5em + 0.75rem + 16px);
}

.tab_form .thin_white_button:focus,
.tab_form .thin_white_button:hover {
  color: #fff;
  -webkit-box-shadow: 0px 5px 20px rgba(255, 255, 255, 0.2);
  -moz-box-shadow: 0px 5px 20px rgba(255, 255, 255, 0.2);
  box-shadow: 0px 5px 20px rgba(255, 255, 255, 0.2);
}

.no_more .open_more_videos {
  display: none !important;
}

.tabs_over_wrap {
  overflow: auto;
}

.tab_accesories_wpar {
  overflow: hidden;
}
//* ----------------------------------------------------------------------------
.bg-accent {
  background: rgb(239, 239, 239);
}

.section_form {
  margin-block: 75px;

  .suport_feedback_form {
    flex-direction: column;
    padding: 0px;
  }

  .suport_feedback_form_box {
    max-width: 100%;
  }
}
//*  Form ---------------------------------------------------------------------
.section_form_body {
  padding: 40px;
  background: transparent url('../img/fon_form.png') center center / cover
    no-repeat;
  object-fit: cover;
  background-color: transparent;
}

.section_form_title {
  margin-bottom: 10px;

  span {
    line-height: 130%;
    display: block;
    color: white;
  }
}

.suport_feedback_form > .section_form_line {
  width: 45%;
}

//*  Form ---------------------------------------------------------------------
.items_greed_box_old-price {
  text-decoration: line-through;
  color: var(--red);
  font-weight: 700;
  text-align: left;
}

.items_greed_box_price {
  font-weight: 700;
  text-align: left;
}

.tabs-buttons {
  display: flex;
  gap: 40px;
  border-bottom: 4px solid var(--red);
  margin-bottom: 20px;
  padding: 20px 0;
  // .tabs-button__item

  &__item {
    font-size: 14px;
    cursor: pointer;
    padding: 10px;
    text-transform: uppercase;
    transition: color 0.3s ease 0s;
    &.active {
      color: var(--red);
    }
  }
}
//* ----------------------------------------------------------------------------
.product-price {
  display: flex;
  align-items: center;
  justify-content: space-between;

  // .product-price__wrapper
  &__wrapper {
    .old-price {
      color: red;
      margin-bottom: 5px;
    }
  }

  .article {
    float: right;
  }

  .product-cart-title {
    font-size: clamp(1.4rem, 3vw, 3.75rem);
  }
}

.product-cart-info {
  padding: 30px 110px 30px 40px;
  @media only screen and (max-width: 1201.98px) {
    padding: 30px 40px;
  }
}
//* ----------------------------------------------------------------------------
.quantity {
  display: none; /* по умолчанию скрыт */
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  width: 100%;

  // .quantity__input
  &__input {
    display: flex;
    input {
      width: 70px;
      height: 20px;
      font-size: 21px;
      text-align: center;
      font-style: normal;
    }
  }
}

.product-card {
  // .product-card__quantity

  &__quantity {
    border: 1px solid var(--red);
    padding: 0 28px;

    &.red_button {
      background-color: transparent !important;

      color: var(--red);
      font-weight: 500;
    }

    .icon {
      user-select: none;
      text-align: center;
      font-style: normal;
      width: 20px;
      height: 20px;
      font-size: 18px !important;
    }
  }
}

.items_greed_wrapper {
  position: relative;
  align-self: start;
}

.cart-user {
  position: relative;
  &__quantity {
    display: none;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    transform: translate(10px, -5px);
    padding: 5px;
    background-color: var(--red);
    border-radius: 50%;
    color: white;
    font-size: 12px;
  }
}

//* ----------------------------------------------------------------------------

.cart-section {
  // .cart-section__content
  &__content {
    display: grid;
    grid-template-columns: 1fr minmax(275px, 25%);
    gap: 8.5%;
    justify-content: space-between;
  }

  // .cart-section__col
  &__col {
    &:nth-child(1) {
      padding: 0 120px 40px 0;
    }

    &:nth-child(2) {
      border: 1px solid rgba(255, 255, 255, 0);
    }
  }
  // .cart-section__delivery
  &__delivery {
    background: #eee;
  }

  // .cart-section__title
  &__title {
    display: flex;
    align-items: center;
    justify-content: start;
    gap: 105px;
    margin-bottom: 30px;
  }

  // .cart-section__header-col
  &__header-col {
    line-height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    .icofont-close {
      transition: all 0.4s ease 0s;
    }

    &.del-button {
      &:hover {
        .icofont-close {
          color: var(--red);
        }
      }
    }
  }

  // .cart-section__icon
  &__icon {
    width: 20px;
    height: 20px;
    margin-right: 3px;

    .icofont-check,
    .icofont-close {
      cursor: pointer;
      color: #5c5c5c;
      &::before {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        font-size: 18px;
      }
    }
  }

  // .cart-section__button
  &__button {
    cursor: pointer;
    white-space: nowrap;
    font-family: Montserrat;
    font-size: 14px;
    font-weight: normal;
    font-stretch: normal;
    font-style: normal;
    line-height: normal;
    letter-spacing: normal;
    text-align: left;
    color: #080808;
    transition: all 0.3s ease;
    font-weight: 500;

    &.selection-button {
      min-width: 131px;
    }
    &:hover {
      color: var(--red);
    }
  }

  // .cart-section__product

  &__product {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
}

.product-cart {
  // .product-cart__item
  &__item {
    padding: 20px 0;
    border-bottom: 1px solid #d4d4d4;
    display: grid;
    grid-template-columns: 22px min-content max-content auto;
    gap: 20px;
  }

  // .product-cart__image

  &__image {
    img {
      width: 117px;
      // max-width: 100%;
    }
  }

  // .product-cart__info
  &__info {
    position: relative;
    padding-left: 20px;
    font-size: 13px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 340px;

    .cart-section__icon {
      margin-right: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 0px;
      right: 0px;
      padding: 5px;
      .icofont-close {
        transition: all 0.4s ease 0s;

        &::before {
          transition: all 0.4s ease 0s;
        }
      }

      &:hover {
        .icofont-close {
          &::before {
            transform: rotate(-90deg);
          }
          color: var(--red);
        }
      }
    }
  }

  // .product-cart__article

  &__article {
    margin-bottom: 17px;
    font-size: 12px;
    color: #000;
    font-weight: 500;
  }

  // .product-cart__title
  &__title {
    line-height: 100%;
    font-size: 21px;

    span {
      font-weight: 600;
      display: block;
    }
  }

  // .product-cart__description
  &__description {
    font-family: Montserrat;
    font-size: 14px;
    font-weight: normal;
    font-stretch: normal;
    font-style: normal;
    line-height: normal;
    letter-spacing: normal;
    text-align: left;
    color: #0b0b0b;
  }

  // .product-cart__price
  &__price {
    .product-cart__old-price {
      padding-bottom: 5px;
    }
  }

  // .product-cart__counter
  &__counter {
    .counter-wrapper {
      display: flex;
      justify-content: center;
      flex-direction: column;
      gap: 25px;
      width: 210px;
      justify-self: flex-end;
    }
  }

  // .product-cart__old-price
  &__old-price {
    text-align: right;
    font-size: 21px;
    font-weight: 600;
    text-decoration: line-through;
    color: var(--red);
    line-height: 100%;
  }

  // .product-cart__new-price
  &__new-price {
    text-align: right;
    font-size: 21px;
    font-weight: 600;
    color: #0b0b0b;
    line-height: 100%;
  }
}
//* ----------------------------------------------------------------------------

.delivery {
  // .delivery__content
  &__content {
    padding: 20px 20px 30px 20px;
  }

  // .delivery__item
  &__item {
    margin-bottom: 15px;
  }

  // .delivery__label
  &__label {
    width: 100%;
    font-family: Montserrat;
    font-size: 18px;
    font-weight: bold;
    color: #080808;
    display: flex;
    align-items: center;
    gap: 10px;

    span {
      white-space: nowrap;
    }
  }

  // delivery__help-info
  &__help-info {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--red);
    display: flex;
    align-items: center;
    justify-content: center;

    span {
      line-height: 100%;
      color: var(--red);
      font-size: 14px;
    }
  }

  // .delivery__result
  &__result {
    margin-top: 30px;
  }

  // .discount-product__sum-product
  &__sum-product {
    margin-top: 33px;
    display: flex;
    justify-content: space-between;
    gap: 30px;
    font-size: 18px;
    font-weight: bold;
  }

  // .discount-product__title

  &__title {
  }

  // .discount-product__sum

  &__sum {
  }

  // .delivery__button
  &__button {
    margin-top: 40px;
    .red_button {
      width: 100%;
    }
  }
}

.select {
  position: relative;
  display: flex;
  justify-content: space-between;

  // .select__drop-down
  &__drop-down {
    position: absolute;
    z-index: 9;
    right: 0;
    top: 5px;
    background-color: #fff;

    box-shadow: 0 0 3px #000000a2;

    .close-button {
      cursor: pointer;
      transform: translateX(10px);
      text-align: right;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      line-height: 100%;

      .icofont-close {
        &::before {
          display: block;
          width: 15px;
          height: 15px;
          font-size: 17px;
        }
      }
    }
  }

  // .select__d-title
  &__d-title {
    padding: 5px 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
  }
  // .select__list
  &__list {
    // position: absolute;
  }

  // .select__list-item
  &__list-item {
    cursor: pointer;
    font-size: 14px;
    padding: 5px 15px;
    user-select: none;
    transition: background-color 0.5s ease 0s;

    &._selected {
      background-color: rgb(255 0 0 / 18%);
      color: var(--red);
    }

    &:hover {
      background-color: rgb(255 0 0 / 10%);
    }
  }

  //.select__input
  &__input {
    font-size: 14px !important;
    pointer-events: none;
  }

  // .select__button
  &__button {
    color: var(--red);
    font-size: 13px;
    font-weight: 500;
    text-transform: lowercase;
  }
}
//* ----------------------------------------------------------------------------
.discount-product {
  display: flex;
  justify-content: space-between;
  gap: 10px;

  // .discount-product__title

  &__title {
    font-size: 14px;
    text-transform: uppercase;
  }

  // .discount-product__price

  &__price {
    font-size: 14px;
  }
}

.purchase-result {
  margin-bottom: 5px;
  display: flex;
  gap: 10px;
  justify-content: space-between;
  // .purchase-result__quantity

  &__quantity {
    font-size: 14px;
  }

  // .purchase-result__sum

  &__sum {
    font-size: 14px;
  }
}
